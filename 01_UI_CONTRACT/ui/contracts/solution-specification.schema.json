{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "specificationId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEWED",
        "APPROVED_FOR_GENERATION"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "enum": [
              "AI_AGENT",
              "MCP_SERVER",
              "SERVICE",
              "BROWSER_AUTOMATION",
              "INTEGRATION",
              "PROCESSOR",
              "INPUT",
              "OUTPUT"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "port": {
                  "type": "string",
                  "minLength": 1
                },
                "schemaRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "port",
                "schemaRef"
              ]
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "port": {
                  "type": "string",
                  "minLength": 1
                },
                "schemaRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "port",
                "schemaRef"
              ]
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "secretRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "deploymentTarget": {
            "type": "string",
            "enum": [
              "LOCAL_UBUNTU",
              "EXPLICIT_EXTERNAL"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "kind",
          "inputs",
          "outputs",
          "steps",
          "secretRefs",
          "deploymentTarget"
        ]
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceComponentId": {
            "type": "string",
            "format": "uuid"
          },
          "sourcePort": {
            "type": "string",
            "minLength": 1
          },
          "targetComponentId": {
            "type": "string",
            "format": "uuid"
          },
          "targetPort": {
            "type": "string",
            "minLength": 1
          },
          "contractRef": {
            "type": "string",
            "minLength": 1
          },
          "dependencyKind": {
            "type": "string",
            "enum": [
              "BUILD",
              "STARTUP",
              "RUNTIME"
            ]
          }
        },
        "required": [
          "id",
          "sourceComponentId",
          "sourcePort",
          "targetComponentId",
          "targetPort",
          "contractRef",
          "dependencyKind"
        ]
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "object"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "schema",
          "digest"
        ]
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "affectedComponents": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "breakingBindings": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "missingInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "buildOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "validationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "affectedComponents",
        "breakingBindings",
        "missingInputs",
        "buildOrder",
        "validationDigest"
      ]
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approvedBy": {
              "const": "OWNER"
            },
            "approvedAt": {
              "type": "string",
              "format": "date-time"
            },
            "revisionDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "approvedBy",
            "approvedAt",
            "revisionDigest"
          ]
        }
      ]
    }
  },
  "required": [
    "specificationId",
    "revision",
    "status",
    "goal",
    "components",
    "bindings",
    "contracts",
    "impact",
    "approval"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kcml:solution-specification:1"
}
