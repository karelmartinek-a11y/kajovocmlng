{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recordKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "RUN",
          "COMPONENT",
          "MESSAGE",
          "EVENT",
          "ERROR",
          "PAYLOAD",
          "SPAN"
        ]
      }
    },
    "runId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "componentId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "clientRef": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SMS",
        "EMAIL",
        "WEBHOOK",
        "API",
        "BROWSER",
        null
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "ANY",
        "INBOUND",
        "OUTBOUND"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "ANY",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "sort": {
      "type": "string",
      "enum": [
        "TIME_ASC",
        "TIME_DESC",
        "DURATION_DESC"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  },
  "required": [
    "recordKinds",
    "runId",
    "componentId",
    "correlationId",
    "clientRef",
    "from",
    "to",
    "channel",
    "direction",
    "result",
    "sort",
    "limit",
    "cursor"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kcml:history-query:1"
}
