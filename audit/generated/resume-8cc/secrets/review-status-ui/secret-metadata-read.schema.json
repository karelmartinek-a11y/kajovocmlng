{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kcml:secret:metadata-read:v1",
  "request": {
    "type": "object",
    "properties": {
      "operationId": {
        "const": "secret.metadata.read"
      },
      "secretId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "operationId",
      "secretId"
    ],
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "stable_name": {
        "type": "string",
        "minLength": 1
      },
      "display_name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "secret_type": {
        "enum": [
          "PASSWORD",
          "API_KEY",
          "BEARER_TOKEN",
          "OAUTH_CLIENT",
          "OAUTH_TOKEN_SET",
          "TOTP_SEED",
          "CERTIFICATE",
          "PRIVATE_KEY",
          "WEBHOOK_SECRET",
          "DATABASE_CREDENTIAL",
          "SESSION_STATE",
          "COOKIE_JAR",
          "SSH_CREDENTIAL",
          "GENERIC_TEXT",
          "GENERIC_BINARY"
        ]
      },
      "purpose_kind": {
        "type": [
          "string",
          "null"
        ]
      },
      "target_object_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "enum": [
          "INACTIVE",
          "ACTIVE",
          "DELETED"
        ],
        "readOnly": true
      },
      "active_version_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "state_version": {
        "maxLength": 19,
        "minLength": 1,
        "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])",
        "type": "string"
      },
      "secret_activation_epoch": {
        "maxLength": 19,
        "minLength": 1,
        "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])",
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "group_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "url": {
        "type": [
          "string",
          "null"
        ]
      },
      "username": {
        "type": [
          "string",
          "null"
        ]
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      },
      "expires_at": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      },
      "deleted_at": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "id",
      "stable_name",
      "display_name",
      "description",
      "secret_type",
      "purpose_kind",
      "target_object_id",
      "status",
      "active_version_id",
      "state_version",
      "secret_activation_epoch",
      "tags",
      "group_name",
      "url",
      "username",
      "notes",
      "expires_at",
      "created_at",
      "updated_at",
      "deleted_at"
    ],
    "additionalProperties": false
  },
  "x-authority": [
    "\u00a78.3 root field inventory",
    "\u00a725.6 root and immutable versions",
    "\u00a772.21 Secret detail/history/value panels"
  ],
  "x-boundary": "Actual canonical physical root fields preserved; no encrypted value or verifier exposed",
  "x-open-required-fields": [
    "rotationPolicy producer/storage missing from physical root",
    "exact bindings separate read",
    "usage history separate read",
    "audit history separate read",
    "OWNER-session authority separate existing boundary"
  ]
}
