{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kcml:audit:core-read:v1",
  "$defs": {
    "CoreQuery": {
      "$id": "urn:kcml:history-query:1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "SMS",
            "EMAIL",
            "WEBHOOK",
            "API",
            "BROWSER",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "clientRef": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "componentId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "correlationId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "enum": [
            "ANY",
            "INBOUND",
            "OUTBOUND"
          ],
          "type": "string"
        },
        "from": {
          "format": "date-time",
          "type": "string"
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "recordKinds": {
          "items": {
            "enum": [
              "RUN",
              "COMPONENT",
              "MESSAGE",
              "EVENT",
              "ERROR",
              "PAYLOAD",
              "SPAN"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "result": {
          "enum": [
            "ANY",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "runId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "sort": {
          "enum": [
            "TIME_ASC",
            "TIME_DESC",
            "DURATION_DESC"
          ],
          "type": "string"
        },
        "to": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "recordKinds",
        "runId",
        "componentId",
        "correlationId",
        "clientRef",
        "from",
        "to",
        "channel",
        "direction",
        "result",
        "sort",
        "limit",
        "cursor"
      ],
      "type": "object"
    },
    "AuditRecord": {
      "oneOf": [
        {
          "$ref": "#/$defs/DomainEventAuditRecord"
        },
        {
          "$ref": "#/$defs/PrerootAuditRecord"
        }
      ]
    },
    "CanonicalAuditBytes": {
      "type": "object",
      "properties": {
        "logicalOperationId": {
          "type": "string",
          "format": "uuid"
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "objectId": {
          "type": "string",
          "format": "uuid"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        },
        "beforeDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "causationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "chainSequence": {
          "maxLength": 19,
          "minLength": 1,
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])",
          "type": "string"
        },
        "previousHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "logicalOperationId",
        "eventId",
        "objectId",
        "actorId",
        "beforeDigest",
        "afterDigest",
        "correlationId",
        "causationId",
        "traceId",
        "occurredAt",
        "chainSequence",
        "previousHash"
      ],
      "additionalProperties": false
    },
    "DomainEventAuditRecord": {
      "type": "object",
      "properties": {
        "recordKind": {
          "const": "DOMAIN_EVENT_AUDIT"
        },
        "auditId": {
          "type": "string",
          "format": "uuid"
        },
        "chainSequence": {
          "maxLength": 19,
          "minLength": 1,
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])",
          "type": "string"
        },
        "previousHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "eventHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "chainFormatVersion": {
          "const": 1
        },
        "canonicalAuditBytesBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "logicalOperationId": {
          "type": "string",
          "format": "uuid"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        },
        "domainEventId": {
          "type": "string",
          "format": "uuid"
        },
        "aggregateId": {
          "type": "string",
          "format": "uuid"
        },
        "aggregateKind": {
          "type": "string",
          "minLength": 1
        },
        "eventType": {
          "type": "string",
          "minLength": 1
        },
        "eventSchemaId": {
          "type": "string",
          "minLength": 1
        },
        "eventSchemaDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "eventPayloadBytesBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "eventPayloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "causationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "archiveRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "recordKind",
        "auditId",
        "chainSequence",
        "previousHash",
        "eventHash",
        "chainFormatVersion",
        "canonicalAuditBytesBase64",
        "logicalOperationId",
        "actorId",
        "domainEventId",
        "aggregateId",
        "aggregateKind",
        "eventType",
        "eventSchemaId",
        "eventSchemaDigest",
        "eventPayloadBytesBase64",
        "eventPayloadDigest",
        "correlationId",
        "causationId",
        "occurredAt",
        "archiveRequired"
      ],
      "additionalProperties": false
    },
    "PrerootAuditRecord": {
      "type": "object",
      "properties": {
        "recordKind": {
          "const": "GENERATION_PREROOT_OUTCOME_AUDIT"
        },
        "auditId": {
          "type": "string",
          "format": "uuid"
        },
        "chainSequence": {
          "maxLength": 19,
          "minLength": 1,
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])",
          "type": "string"
        },
        "previousHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "eventHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "chainFormatVersion": {
          "const": 1
        },
        "canonicalAuditBytesBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "logicalOperationId": {
          "type": "string",
          "format": "uuid"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        },
        "archiveRequired": {
          "type": "boolean"
        },
        "operationId": {
          "const": "generation.job.create"
        },
        "domainEventId": {
          "type": "null"
        },
        "prospectiveJobId": {
          "type": "string",
          "format": "uuid"
        },
        "retainedStateVersion": {
          "maxLength": 19,
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])",
          "type": "string"
        },
        "retainedOutcomeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "retainedOutcomeBytesBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "retainedOutcome": {
          "$ref": "#/$defs/PrerootOutcome"
        }
      },
      "required": [
        "recordKind",
        "auditId",
        "chainSequence",
        "previousHash",
        "eventHash",
        "chainFormatVersion",
        "canonicalAuditBytesBase64",
        "logicalOperationId",
        "actorId",
        "archiveRequired",
        "operationId",
        "domainEventId",
        "prospectiveJobId",
        "retainedStateVersion",
        "retainedOutcomeDigest",
        "retainedOutcomeBytesBase64",
        "retainedOutcome"
      ],
      "additionalProperties": false
    },
    "PrerootOutcome": {
      "type": "object",
      "properties": {
        "routeId": {
          "const": "route.0215"
        },
        "operationId": {
          "const": "generation.job.create"
        },
        "logicalOperationId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "output": {
          "type": "null"
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "stableCode": {
                  "enum": [
                    "CREATE_CANCELLED",
                    "CREATE_INPUT_INVALID",
                    "CREATE_AUTHENTICATION_REQUIRED",
                    "CREATE_REFERENCE_INVALID",
                    "CREATE_POLICY_UNRESOLVED",
                    "CREATE_RECOVERY_BARRIER",
                    "IDEMPOTENCY_CONFLICT",
                    "CREATE_PERSISTENCE_FAILED",
                    "SIDE_EFFECT_OUTCOME_UNKNOWN",
                    "FOLLOW_UP_ATOMIC_ADMISSION_UNVERIFIED",
                    "FOLLOW_UP_BASIS_BYTES_DIGEST_MISMATCH",
                    "FOLLOW_UP_BASIS_BYTES_UNAVAILABLE",
                    "FOLLOW_UP_BASIS_DIGEST_CONFLICT",
                    "FOLLOW_UP_BASIS_IDENTITY_MISMATCH",
                    "FOLLOW_UP_BASIS_INCONSISTENT",
                    "FOLLOW_UP_BASIS_INSUFFICIENT",
                    "FOLLOW_UP_BASIS_INVALID",
                    "FOLLOW_UP_BASIS_NOT_IMMUTABLE",
                    "FOLLOW_UP_BASIS_UNAVAILABLE",
                    "FOLLOW_UP_FINAL_OUTPUT_UNPUBLISHED",
                    "FOLLOW_UP_FROZEN_DESCRIPTOR_INVALID",
                    "FOLLOW_UP_FROZEN_IDENTITY_MISMATCH",
                    "FOLLOW_UP_FROZEN_LINEAGE_DIGEST_MISMATCH",
                    "FOLLOW_UP_FROZEN_SNAPSHOT_UNAVAILABLE",
                    "FOLLOW_UP_KIND_REQUIRED",
                    "FOLLOW_UP_PARENT_REQUIRED",
                    "FOLLOW_UP_PUBLICATION_RECEIPT_MISMATCH",
                    "FOLLOW_UP_PUBLICATION_RECEIPT_UNVERIFIED",
                    "FOLLOW_UP_SNAPSHOT_IDENTITY_INVALID",
                    "FOLLOW_UP_SOURCE_OWNER_MISMATCH",
                    "FOLLOW_UP_SOURCE_STATE_INVALID"
                  ]
                },
                "classification": {
                  "enum": [
                    "AUTHENTICATION",
                    "AUTHORIZATION",
                    "CANCELLED",
                    "CONFLICT",
                    "DEPENDENCY",
                    "INTERNAL",
                    "UNKNOWN",
                    "VALIDATION"
                  ]
                },
                "retryDirective": {
                  "enum": [
                    "DO_NOT_RETRY",
                    "RECONCILE_THEN_RETRY",
                    "RETRY_SAME_OPERATION"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "detailsDigest": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "stableCode",
                "classification",
                "retryDirective",
                "message",
                "detailsDigest"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "CREATE_CANCELLED"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "CANCELLED"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "CREATE_INPUT_INVALID"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "CREATE_AUTHENTICATION_REQUIRED"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "AUTHENTICATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "CREATE_REFERENCE_INVALID"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "CREATE_POLICY_UNRESOLVED"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "DEPENDENCY"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "CREATE_RECOVERY_BARRIER"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "CONFLICT"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "IDEMPOTENCY_CONFLICT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "CONFLICT"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "CREATE_PERSISTENCE_FAILED"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "INTERNAL"
                      },
                      "retryDirective": {
                        "const": "RETRY_SAME_OPERATION"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "SIDE_EFFECT_OUTCOME_UNKNOWN"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "UNKNOWN"
                      },
                      "retryDirective": {
                        "const": "RECONCILE_THEN_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_ATOMIC_ADMISSION_UNVERIFIED"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "DEPENDENCY"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_BYTES_DIGEST_MISMATCH"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_BYTES_UNAVAILABLE"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "DEPENDENCY"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_DIGEST_CONFLICT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_IDENTITY_MISMATCH"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_INCONSISTENT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_INSUFFICIENT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_INVALID"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_NOT_IMMUTABLE"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
                      },
                      "retryDirective": {
                        "const": "DO_NOT_RETRY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "stableCode": {
                        "const": "FOLLOW_UP_BASIS_UNAVAILABLE"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "classification": {
                        "const": "VALIDATION"
